{
  "name": "roadclub-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync:core": "node scripts/sync-core.mjs",
    "db:verify": "bash scripts/verify-migrations.sh",
    "mobile": "npm run start --workspace apps/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
