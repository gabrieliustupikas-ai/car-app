# Copy to apps/mobile/.env (Expo reads EXPO_PUBLIC_* at build time). Never commit real values.
# Only EXPO_PUBLIC_* variables are embedded in the app bundle — never put service-role keys there.

# Supabase (Project Settings → API). Leave empty to run fully offline in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (pk.*). Leave empty to use the built-in fallback map placeholder.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Optional custom Mapbox Studio styles; defaults to Mapbox Standard (night/day presets).
EXPO_PUBLIC_MAPBOX_STYLE_DARK=
EXPO_PUBLIC_MAPBOX_STYLE_LIGHT=

# Error reporting / analytics (stubbed in Phase 1; wire a Sentry DSN here later)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# EAS project id (optional, for builds)
EAS_PROJECT_ID=

# ---------- server-side only (supabase/functions/.env, `supabase secrets set`) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions.
# LIVEKIT_API_KEY=      # Phase 4
# LIVEKIT_API_SECRET=   # Phase 4
# LIVEKIT_URL=          # Phase 4
